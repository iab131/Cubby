# Copy these into Vercel > Project > Settings > Environment Variables.
# For testing on your computer, copy this file to .env.local and fill it in.
# Both come from Supabase > Project Settings > API Keys. The publishable key is meant to be public.
# Never put the secret (service_role) key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Older projects: use the "anon public" key instead, as VITE_SUPABASE_ANON_KEY
