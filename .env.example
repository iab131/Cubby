# Copy these into Vercel > Project > Settings > Environment Variables.
# For testing on your computer, copy this file to .env.local and fill it in.
# Both come from Supabase > Project Settings > API Keys. The publishable key is meant to be public.
# Never put the secret (service_role) key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Older projects: use the "anon public" key instead, as VITE_SUPABASE_ANON_KEY
# Google's sign-in in a popup, so Google's sign-in screen shows your site instead of the supabase.co address.
# Use the same Web client ID you pasted into Supabase > Authentication > Sign In / Providers > Google,
# and add https://<your site>/google-callback.html to its Authorized redirect URIs (see SETUP.md).
# Leave it out and sign-in still works, through Supabase's redirect.
VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
